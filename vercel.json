{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    },
    "api/news.js": {
      "maxDuration": 15
    }
  }
}
