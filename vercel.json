{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/trpc.ts": {
      "maxDuration": 60
    },
    "api/trpc/[...path].ts": {
      "maxDuration": 60
    },
    "api/mlb.js": {
      "maxDuration": 30
    },
    "api/uptime-monitor.ts": {
      "maxDuration": 60
    },
    "api/scheduled/daily-uptime-monitor.ts": {
      "maxDuration": 60
    },
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "server/data/lahman/**"
    },
    "api/news.js": {
      "maxDuration": 15
    }
  }
}
