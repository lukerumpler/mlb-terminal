# Copy to .env and fill in. Never commit real values. Names only; see README.md.

# --- Core ---
PORT=3000
NODE_ENV=development
# MySQL/MariaDB connection string. Required by the app's durable cache, uptime monitor
# and the MLB warehouse (pnpm ingest:mlb). The warehouse routes answer 503 without it.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/skip
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
# Client-side only: override the API origin when the UI is hosted apart from the API.
VITE_API_BASE=
# Comma-separated CORS allow-list. Empty in development allows any origin.
ALLOWED_ORIGIN=
# Outbound User-Agent for upstream data providers.
USER_AGENT=

# --- Maps (client/src/components/Map.tsx) ---
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# --- AI provider (natural-language query, voice notes) ---
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=

# --- Security and limits ---
# report-only (default) | enforce | off. Review browser-console violations before enforcing.
CSP_MODE=report-only
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=10000
# Trusted proxies in front of the app. Leave unset unless you have confirmed the count.
RATE_LIMIT_TRUSTED_PROXY_HOPS=
LLM_RATE_LIMIT_MAX=8
LLM_RATE_LIMIT_WINDOW_MS=60000
SHUTDOWN_TIMEOUT_MS=10000

# --- Cache tuning (seconds; defaults shown) ---
TEAM_EFFICIENCY_FRESH_SECONDS=300
TEAM_EFFICIENCY_STALE_SECONDS=86400
TEAM_FINANCIALS_FRESH_SECONDS=1800
TEAM_FINANCIALS_STALE_SECONDS=21600

# --- Release gate / staging (optional) ---
SKIP_RELEASE_BASE_URL=
SKIP_RELEASE_SEASON=
STAGING_PROVIDER_FAILURE_HOOK_ENABLED=
STAGING_PROVIDER_FAILURE_HOOK_TOKEN=

# --- Tests only ---
# Enables the DB-gated warehouse suites; run them with --no-file-parallelism.
MLB_TEST_DATABASE_URL=
# Points the deployment smoke test at a Vercel preview.
VERCEL_SMOKE_BASE_URL=
# Per-request timeout for the smoke test, in milliseconds (default 15000).
VERCEL_SMOKE_TIMEOUT_MS=
