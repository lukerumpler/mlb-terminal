  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check vitest.config.ts client/src/components/OverviewCharts.jsx server/api/routes.ts server/api/routes.test.ts server/api/shared.test.ts scripts/release-shared-comparison.mjs scripts/provider-health-smoke.mjs test/release-gate-tools.test.js release/release-gate-baseline.json docs/RELEASE_WORKFLOW.md package.json server/security-headers.ts server/security-headers.test.ts server/_core/shutdown.ts server/_core/shutdown.test.ts server/season.ts server/season.test.ts server/api/mlb-warehouse.js server/api/mlb-warehouse.test.ts server/api/mlb-warehouse.integration.test.ts server/api/scheduled-ingest-mlb.ts server/api/scheduled-ingest-mlb.test.ts server/mlb-warehouse/scheduling.test.ts server/vercel-deployment-smoke.test.ts .github/workflows/warehouse-db-tests.yml .github/workflows/quality.yml .github/dependabot.yml server/_core/voiceTranscription.test.ts server/routers.voice-storage.test.ts server/app.body-limit.test.ts server/api/feed.test.ts server/api/comparison-summary.test.ts server/api/natural-search.test.ts test/news-badge-diagnostics-components.test.jsx test/voice-note-recorder.test.jsx server/api/_shared.js server/api/_shared.d.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:smoke": "vitest run server/vercel-deployment-smoke.test.ts",
    "release:compare": "node scripts/release-shared-comparison.mjs",
    "release:providers": "node scripts/provider-health-smoke.mjs",
    "audit:prospects": "node scripts/audit-prospect-coverage.mjs",
    "audit:organization-rosters": "node scripts/audit-organization-rosters.mjs",
    "release:gate": "pnpm release:compare && pnpm release:providers && pnpm check && pnpm lint && pnpm test && pnpm build",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "ingest:mlb": "tsx scripts/mlb-ingest.ts"
  },
